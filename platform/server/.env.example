# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env lên git.
PORT=8080
# Để trống khi dùng Cloudflare quick tunnel (địa chỉ đổi mỗi lần); có tên miền thì điền vd https://clickdeal.vn
PUBLIC_BASE_URL=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://clickdeal:DOI_MAT_KHAU@db:5432/clickdeal
# Khóa chính 32 byte, tạo bằng: openssl rand -base64 32  (production: chuyển sang KMS)
MASTER_KEY=
COOKIE_SECURE=true
AUTO_APPROVE_AFFILIATES=false
ACCESSTRADE_BASE_URL=https://api.accesstrade.vn
SHOPEE_GRAPHQL_URL=https://open-api.affiliate.shopee.vn/graphql
SYNC_INTERVAL_MS=1200000
NETWORK_MIN_INTERVAL_MS=6500
