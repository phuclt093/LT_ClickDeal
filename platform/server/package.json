{
  "name": "clickdeal-server",
  "version": "0.1.0",
  "description": "ClickDeal Platform API: tạo link hoàn tiền, đồng bộ đơn, quản lý affiliate",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx src/migrate.ts",
    "build": "tsc -p .",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p . --noEmit",
    "create-admin": "tsx src/create-admin.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "argon2": "^0.41.1",
    "fastify": "^5.12.7",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module"
}
